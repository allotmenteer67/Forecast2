{
  "name": "Forecast Compare",
  "version": "0.4.0",
  "platform": "GitHub Pages",
  "technology": [
    "HTML",
    "CSS",
    "JavaScript"
  ],
  "conditions": [
    { "id": "rain", "name": "Rain", "unit": "mm" },
    { "id": "cloud", "name": "Cloud", "unit": "%" },
    { "id": "wind", "name": "Wind", "unit": "mph" },
    { "id": "temperature", "name": "Temperature", "unit": "\u00b0C" },
    { "id": "sunshine", "name": "Sunshine", "unit": "hrs" },
    { "id": "uv", "name": "UV", "unit": "index" }
  ],
  "days": [7, 6, 5, 4, 3, 2, 1],
  "rain_probability": false,
  "forecasters": [
    { "id": "metoffice", "name": "Met Office", "enabled": true },
    { "id": "bbc", "name": "BBC", "enabled": true },
    { "id": "meteo", "name": "Meteoblue", "enabled": true },
    { "id": "yr", "name": "YR", "enabled": true },
    { "id": "accuweather", "name": "AccuWeather", "enabled": true },
    { "id": "netweather", "name": "Netweather", "enabled": false },
    { "id": "xcweather", "name": "XCWeather", "enabled": false },
    { "id": "wunderground", "name": "Weather Underground", "enabled": false },
    { "id": "weatherapi", "name": "WeatherAPI", "enabled": false },
    { "id": "windy", "name": "Windy", "enabled": false },
    { "id": "openweather", "name": "OpenWeatherMap", "enabled": false },
    { "id": "tomorrow", "name": "Tomorrow.io", "enabled": false }
  ],
  "rollback_days": 6,
  "forecaster_data": "demo",
  "actual_data": {
    "source": "Open-Meteo",
    "geocoding": "postcodes.io",
    "live": true,
    "note": "Actual weather is fetched live for the selected target date. Forecaster predictions remain demo data until real forecast APIs are wired in per source."
  }
}
